<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/forest_deep"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_crypt"
        android:scaleType="centerCrop"/>
    <View
        android:background="#99081410"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="96dp"
                android:layout_height="40dp"
                android:src="@drawable/btn_back"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/cream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:src="@drawable/crown_relic"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/el_griffin"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#f3e8c8"
                    android:id="@+id/aboutBody"
                    android:background="@drawable/shape_panel"
                    android:paddingLeft="28dp"
                    android:paddingTop="28dp"
                    android:paddingRight="28dp"
                    android:paddingBottom="28dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:src="@drawable/deco_pads"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxHeight="120dp"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/deco_moss"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxHeight="120dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
