<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/forest_deep"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bgRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_grove"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layerLoading"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.16"/>
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">
            <ImageView
                android:id="@+id/loadHalo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/el_halo"
                android:scaleType="fitCenter"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/loadCrown"
                android:layout_width="188dp"
                android:layout_height="188dp"
                android:src="@drawable/crown_relic"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <TextView
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/cream"
            android:id="@+id/loadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/gold_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lobby_tag"/>
        <FrameLayout
            android:background="@drawable/shape_bar"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="28dp">
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/loadFill"
                android:background="@drawable/progress_fill"
                android:layout_width="0dp"
                android:layout_height="14dp"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/gold_soft"
            android:id="@+id/loadPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0%"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#dce8d8"
            android:gravity="center"
            android:id="@+id/loadTip"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/loading_tip"/>
        <ImageView
            android:id="@+id/loadFirefly"
            android:layout_width="84dp"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/spr_firefly"
            android:scaleType="fitCenter"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.2"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/layerLobby"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="28dp"
            android:paddingRight="24dp"
            android:paddingBottom="28dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/cream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/gold_soft"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/lobby_tag"/>
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="12dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/el_halo"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/lobbyCrown"
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:src="@drawable/crown_relic"
                    android:scaleType="fitCenter"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/el_emerald"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/el_gold"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/el_diamond"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="#d8e8d4"
                android:id="@+id/lobbyProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <FrameLayout
                android:id="@+id/btnPlay"
                android:background="@drawable/shape_btn_amber"
                android:layout_width="260dp"
                android:layout_height="50dp"
                android:layout_marginTop="18dp">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_play"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/btnEndless"
                android:background="@drawable/shape_btn_azure"
                android:layout_width="260dp"
                android:layout_height="50dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_endless"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/btnAbout"
                android:background="@drawable/shape_btn_amber"
                android:layout_width="260dp"
                android:layout_height="50dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_about"/>
            </FrameLayout>
            <ImageView
                android:layout_width="280dp"
                android:layout_height="124dp"
                android:layout_marginTop="18dp"
                android:src="@drawable/deco_firefly"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
