<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/btnHalt"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="II"
        android:layout_alignParentTop="true"
        android:textAllCaps="false"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"
        android:backgroundTint="#cc2a4a6a"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/ink_dark"
        android:id="@+id/txtMarks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Score: 0"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="70dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/ink_accent"
        android:id="@+id/txtGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/tip_play"
        android:layout_below="@+id/txtMarks"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="70dp"/>
    <com.tjwqxmzplk.sparkslidenest.BarrierCanvas
        android:id="@+id/fieldPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/txtGuide"/>
</RelativeLayout>
